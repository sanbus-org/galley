{
  "name": "@sanbus/galley-wasm",
  "version": "0.0.0",
  "description": "Galley JavaScript bindings over WebAssembly (@sanbus/galley-core over a WASI reactor module built from bindings/c/galley.h)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": ["dist", "src", "build.mjs", "README.md"],
  "bin": {
    "galley-js-wasm": "./build.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json --noCheck --types \"\"",
    "prepublishOnly": "npm run build",
    "test": "node tests/test_bindings.mjs"
  },
  "keywords": ["galley", "parser", "javascript", "typescript", "wasm", "wasi"],
  "dependencies": {
    "@sanbus/galley-core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
