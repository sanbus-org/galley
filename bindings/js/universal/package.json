{
  "name": "@sanbus/galley",
  "version": "0.0.1",
  "description": "Universal Galley JavaScript bindings: one package for Node, Bun, Deno, and browsers over @sanbus/galley-core, with native-first backend selection and WebAssembly fallback",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "build.mjs", "README.md"],
  "bin": {
    "galley": "./build.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json --noCheck --types \"\"",
    "prepublishOnly": "npm run build",
    "test": "node tests/test_loader.mjs"
  },
  "keywords": ["galley", "parser", "javascript", "typescript", "ffi", "wasm"],
  "dependencies": {
    "@sanbus/galley-core": "file:../core",
    "@sanbus/galley-node": "file:../node",
    "@sanbus/galley-bun": "file:../bun",
    "@sanbus/galley-deno": "file:../deno",
    "@sanbus/galley-wasm": "file:../wasm"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
