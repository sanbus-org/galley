func (d HookDoor) Span(node Node) (start uint64, length uint64, err error) {
	return d.door().span(node)
}

// LineColumn returns the 1-based line and column of a node's first byte
// through the parse-time door.
func (d HookDoor) LineColumn(node Node) (line uint32, column uint32, err error) {
	return d.door().lineColumn(node)
}

func procedureStatus(status C.longlong) error {
	if status >= 0 {
		return nil
	}
	return Error(int32(status))
}

// DropSelf drops the current node from the parse.
func (a ProcedureArgs) DropSelf() error {
	session, err := a.open()
	if err != nil {
		return err
	}
	return procedureStatus(C.galley_procedure_drop_self(session, a.cticket()))
}

// DropChildren drops children of the current node.
func (a ProcedureArgs) DropChildren() error {
	session, err := a.open()
	if err != nil {
		return err
	}
	return procedureStatus(C.galley_procedure_drop_children(session, a.cticket()))
}

// DropIfEmpty drops the current node when it has no children.
func (a ProcedureArgs) DropIfEmpty() error {
	session, err := a.open()
	if err != nil {
		return err
	}
	return procedureStatus(C.galley_procedure_drop_if_empty(session, a.cticket()))
}

// ReplaceWithChildren replaces the current node with its children.
func (a ProcedureArgs) ReplaceWithChildren() error {
	session, err := a.open()
	if err != nil {
		return err
	}
	return procedureStatus(C.galley_procedure_replace_with_children(session, a.cticket()))
}

// ReportSemanticError records a semantic error on the current node and
// returns the running total. Parsing continues; a syntax-clean parse with
// any semantic error fails with ErrSemantic.
func (a ProcedureArgs) ReportSemanticError(message string) (uint64, error) {
	session, err := a.open()
	if err != nil {
		return 0, err
	}
	cMessage := C.CString(message)
	defer C.free(unsafe.Pointer(cMessage))
	status := C.galley_procedure_report_semantic_error(session, a.cticket(), cMessage, C.size_t(len(message)))
	if status < 0 {
		return 0, Error(int32(status))
	}
	return uint64(status), nil
}

// Line is the scanner line during this reduction.
func (a ProcedureArgs) Line() (uint32, error) {
	session, err := a.open()
	if err != nil {
		return 0, err
	}
	line := C.galley_procedure_context_line(session, a.cticket())
	if line < 0 {
		return 0, Error(int32(line))
	}
	return uint32(line), nil
}

// Column is the scanner column during this reduction.
func (a ProcedureArgs) Column() (uint32, error) {
	session, err := a.open()
	if err != nil {
		return 0, err
	}
	column := C.galley_procedure_context_column(session, a.cticket())
	if column < 0 {
		return 0, Error(int32(column))
	}
	return uint32(column), nil
}
