import (
	"fmt"
	"sync"
	"sync/atomic"
	"unsafe"
)

func (s *Session) treeStatus(status C.longlong) error {
	if status >= 0 {
		return nil
	}
	return Error(int32(status))
}

func boolToCInt(value bool) C.int {
	if value {
		return 1
	}
	return 0
}

// cToNode stamps a C node address with the generation of the tree it was
// read from, reporting false for invalid-node results (missing links, empty
// chains).
func cToNode(generation uint64, value C.ulonglong) (Node, bool) {
	if uint64(value) == invalidAddress {
		return Node{}, false
	}
	return Node{generation: generation, address: uint64(value)}, true
}

// invalidAddress is GALLEY_INVALID_NODE; noVariable is GALLEY_NO_VARIABLE.
// Both are non-negative, like every address: only statuses are negative.
const (
	invalidAddress = uint64(0x7FFFFFFFFFFFFFFF)
	noVariable     = int64(0x7FFFFFFFFFFFFFFF)
)

// Node is a handle to a node of one parse's AST: the core's parse
// generation the node belongs to, and its address. Every read and edit
// hands the generation back to the core, which refuses one it no longer
// holds with ErrStaleTree, so a Node from an earlier parse never reads the
// node that took its address.
type Node struct {
	generation uint64
	address    uint64
}

// Index returns the raw address backing the node (it indexes Snapshot
// columns).
func (n Node) Index() uint64 { return n.address }

// InvalidNode is the sentinel for "no node here". It belongs to no parse
// (generation 0 is never live), so using it is ErrStaleTree.
var InvalidNode = Node{address: invalidAddress}

// Status codes mirrored from the C API (negative values are failures).
type Error int32

const (
	ErrNullArgument         Error = -1
	ErrSyntax               Error = -2
	ErrIndentation          Error = -3
	ErrStackOverflow        Error = -4
	ErrASTCapacityExceeded  Error = -5
	ErrUnterminatedRawString Error = -6
	ErrOutOfMemory          Error = -7
	ErrInternal             Error = -8
	ErrNoDiagnostic         Error = -9
	ErrInvalidNode          Error = -10
	ErrIO                   Error = -11
	ErrSemantic             Error = -12
	// ErrSessionInUse: a parse holds the session exclusively; a post-parse
	// accessor was called mid-parse (hook code must use the args door).
	ErrSessionInUse Error = -13
	// ErrStaleTree: a handle's tree is gone — the session parsed again
	// since, the last parse published nothing, or nothing was ever
	// published. One failure for every source that can find a tree gone,
	// so a dead handle never reads as a live one.
	ErrStaleTree Error = -14
	// ErrStaleHook: a procedure call made with the arguments of a hook that
	// has returned; the core refuses it, whatever the tree is now.
	ErrStaleHook Error = -15
	// ErrHookFailed: a host hook's dispatch reported failure and the parse
	// stopped. Only a library built with a host shim returns it; Go hooks
	// cannot fail yet.
	ErrHookFailed Error = -16
	// ErrOutOfRange: an index past a table the core reads by number: a hook
	// name, a grammar symbol or variable name, an expected-token or
	// context-name index. A tree position past its storage is
	// ErrInvalidNode, a recorded diagnostic past its count ErrNoDiagnostic.
	ErrOutOfRange Error = -17
	// ErrInvalidArgument: a non-null argument the call cannot accept: an
	// option value outside its domain, or a hook-enable count that does not
	// match the library's hook count. A nil argument is ErrNullArgument.
	ErrInvalidArgument Error = -18
)

// statusCarriesDiagnostic reports whether a failure with this code carries
// the session's diagnostic: exactly the statuses that ended a parse that
// ran, whose diagnostic then belongs to that attempt. A *ParseError built
// from any other status carries none — a file-read failure included,
// whether it happened before the parse began or, in a streaming build,
// during it.
func statusCarriesDiagnostic(code Error) bool {
	switch code {
	case ErrSyntax, ErrSemantic, ErrIndentation, ErrStackOverflow,
		ErrASTCapacityExceeded, ErrUnterminatedRawString, ErrOutOfMemory,
		ErrHookFailed:
		return true
	}
	return false
}

var errorDescriptions = map[Error]string{
	ErrNullArgument:         "null argument",
	ErrSyntax:               "syntax error",
	ErrIndentation:          "indentation error",
	ErrStackOverflow:        "parser stack overflow",
	ErrASTCapacityExceeded:  "AST capacity exceeded",
	ErrUnterminatedRawString: "unterminated raw string",
	ErrOutOfMemory:          "out of memory",
	ErrInternal:             "internal error",
	ErrNoDiagnostic:         "no diagnostic available",
	ErrInvalidNode:          "invalid node address",
	ErrIO:                   "I/O error",
	ErrSemantic:             "semantic error",
	ErrSessionInUse:         "session in use",
	ErrStaleTree:            "stale tree",
	ErrStaleHook:            "stale hook",
	ErrHookFailed:           "hook failed",
	ErrOutOfRange:           "out of range",
	ErrInvalidArgument:      "invalid argument",
}

func (e Error) Error() string {
	if description, ok := errorDescriptions[e]; ok {
		return description
	}
	return "unknown galley error"
}

// Version returns the build-supplied version string of this library.
func Version() string {
	return C.GoString(C.galley_version())
}

// HasAST reports whether the library was built with AST construction.
func HasAST() bool {
	return C.galley_has_ast() != 0
}

// SymbolCount returns the number of grammar symbols: the generated
// grammar's variables and terminals share one table. Fixed for the process
// lifetime; the count takes nothing and cannot fail.
func SymbolCount() uint64 {
	return uint64(C.galley_symbol_count())
}

// VariableCount returns the number of grammar variables. Fixed for the
// process lifetime; the count takes nothing and cannot fail.
func VariableCount() uint64 {
	return uint64(C.galley_variable_count())
}

// HooksCount returns the number of hooks this library forwards to a host:
// every hook its parser binds, none when procedures are disabled. A library
// built with C, C++, Rust, or Go hooks reports zero hooks. Fixed for the
// process lifetime; the count takes nothing and cannot fail.
func HooksCount() uint64 {
	return uint64(C.galley_hooks_count())
}

// HookName returns the name of the host hook at index, always an
// identifier: reduction, reduction_<Variable>, reduction_<terminal stem>, or
// reduction_<Variable>_<RhsIndex>. The bytes are a Go copy of static storage
// valid for the process lifetime. An index at or past HooksCount is
// ErrOutOfRange.
func HookName(index uint64) ([]byte, error) {
	var data *C.char
	var length C.size_t
	if status := C.galley_hooks_name(C.size_t(index), &data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

// SessionOptions selects session behavior; zero fields select library
// defaults, the ones DefaultOptions spells out. A negative MaxErrors,
// RecoveryWindow, or Verbosity, or a non-finite ASTPreallocationRatio, is
// rejected by the core with ErrInvalidArgument.
type SessionOptions struct {
	MaxErrors               int32
	RecoveryWindow          int32
	StackOverflowRecovery   bool
	SyntaxErrorStackDepth   uint32
	Verbosity               int32
	ASTPreallocationRatio   float64
	ASTPreallocationCap     uint64
	// MessageOverrides registers syntax-error message overrides: when a
	// site's resolution chain contains the name, it reports the message
	// verbatim, ahead of grammar hooks and the built-in renderer.
	MessageOverrides map[string]string
}

// DefaultOptions mirrors the defaults of the C and Rust consumers.
func DefaultOptions() SessionOptions {
	return SessionOptions{
		MaxErrors:             10,
		RecoveryWindow:        500,
		StackOverflowRecovery: false,
		SyntaxErrorStackDepth: 0,
		Verbosity:             0,
		ASTPreallocationRatio: -1,
		ASTPreallocationCap:   0,
	}
}

// Session wraps one parsing session. Sessions own their IO backend and
// allocator, and are not safe for concurrent use: keep one per goroutine or
// guard it externally. Call Close when done.
type Session struct {
	ptr  *C.GalleySession
	life *sessionLife
}

// sessionLife is the Go-side lifetime of one session's parses. Its epoch
// moves when a parse ends and when the session closes; a hook door records
// the epoch it was taken at and is usable only while that is still the
// session's, so a door kept past its parse is refused without its native
// pointer being read. One counter per session, no allocation per door call.
type sessionLife struct {
	epoch uint64
}

// sessions finds a session's life from the session a hook's arguments name.
var sessions sync.Map // uintptr of the *C.GalleySession -> *sessionLife

// parseEnded ends the lifetime of every hook door taken during the parse that
// just returned. A parse the core refused never reaches it: a running parse
// keeps its hooks and doors.
func (s *Session) parseEnded() {
	if s.life != nil {
		atomic.AddUint64(&s.life.epoch, 1)
	}
}

// New creates a session with default options.
func New() (*Session, error) {
	return WithOptions(DefaultOptions())
}

// WithOptions creates a session with explicit options. The core owns every
// check: a negative MaxErrors, RecoveryWindow, or Verbosity, or a
// non-finite ASTPreallocationRatio, comes back as ErrInvalidArgument, and an
// initialization failure as ErrOutOfMemory.
func WithOptions(options SessionOptions) (*Session, error) {
	cOptions := &C.GalleyCOptions{
		max_errors:                C.int(options.MaxErrors),
		recovery_window:           C.int(options.RecoveryWindow),
		stack_overflow_recovery:   boolToCInt(options.StackOverflowRecovery),
		syntax_error_stack_depth:  C.uint(options.SyntaxErrorStackDepth),
		verbosity:                 C.int(options.Verbosity),
		ast_preallocation_ratio:   C.double(options.ASTPreallocationRatio),
		ast_preallocation_cap:     C.ulonglong(options.ASTPreallocationCap),
	}
	// Every create refusal is the status the core mapped, never a
	// reinterpretation: a rejected option value reads invalid argument.
	var ptr *C.GalleySession
	if status := C.galley_session_create(cOptions, &ptr); status < 0 {
		return nil, Error(int32(status))
	}
	if ptr == nil {
		return nil, ErrOutOfMemory
	}
	session := &Session{ptr: ptr, life: &sessionLife{}}
	sessions.Store(uintptr(unsafe.Pointer(ptr)), session.life)
	for name, message := range options.MessageOverrides {
		cName := C.CString(name)
		cMessage := C.CString(message)
		status := C.galley_session_set_message_override(session.ptr, cName, C.size_t(len(name)), cMessage, C.size_t(len(message)))
		C.free(unsafe.Pointer(cName))
		C.free(unsafe.Pointer(cMessage))
		if status < 0 {
			// A session whose overrides are incomplete is no session: hand
			// out none rather than one that silently ignores options. The
			// destroy cannot fail here: the session was never shared.
			_ = C.galley_session_destroy(session.ptr)
			sessions.Delete(uintptr(unsafe.Pointer(session.ptr)))
			return nil, Error(int32(status))
		}
	}
	return session, nil
}

// Close destroys the session. Safe to call more than once: a session that is
// already closed answers nil. While a parse is in flight — from another
// thread or from one of the session's own hooks — the core refuses, so Close
// returns that error and touches nothing: the registration, the running
// parse's hook state and the pointer all stay as they were, and the session
// keeps parsing and closes later.
func (s *Session) Close() error {
	if s.ptr == nil {
		return nil
	}
	if _, err := s.status(C.galley_session_destroy(s.ptr)); err != nil {
		return err
	}
	sessions.Delete(uintptr(unsafe.Pointer(s.ptr)))
	s.parseEnded()
	s.ptr = nil
	return nil
}

func (s *Session) status(status C.longlong) (int, error) {
	if status >= 0 {
		return int(status), nil
	}
	return 0, Error(int32(status))
}

// ParseError is the failure of one parse leg: the status the parse stopped
// with and, when the parse recorded one, a snapshot of the diagnostic it
// stopped at, frozen into Go when the failure is created. Only parse legs
// return it; every other call returns the bare Error.
type ParseError struct {
	Status     Error
	Diagnostic *Diagnostic
}

// Error is the status's description, like the bare Error's.
func (e *ParseError) Error() string { return e.Status.Error() }

// Unwrap exposes the status, so errors.Is(err, ErrSyntax) and
// errors.As(err, &statusError) hold for every parse failure.
func (e *ParseError) Unwrap() error { return e.Status }

// parseOutcome is the one gate ending every parse leg: it ends the parse's
// hook-door lifetime (parseEnded) and maps the core's status to the leg's
// result — the byte count, or a *ParseError carrying the diagnostic the
// parse stopped at. Every leg that entered the parse ends its lifetime
// whatever it returns; only the call the core refused with ErrSessionInUse
// entered nothing, so the running parse keeps its hooks and doors. A failure
// carries a diagnostic exactly when its status is one that ended a parse
// that ran (statusCarriesDiagnostic); a failure built from any other status
// carries none. Any other refused diagnostic read replaces the parse failure
// rather than being folded into "no snapshot".
func (s *Session) parseOutcome(status C.longlong) (int, error) {
	if status >= 0 {
		s.parseEnded()
		return int(status), nil
	}
	failure := &ParseError{Status: Error(int32(status))}
	if failure.Status == ErrSessionInUse {
		return 0, failure
	}
	s.parseEnded()
	if !statusCarriesDiagnostic(failure.Status) {
		return 0, failure
	}
	diagnostic, present, err := s.Diagnostic()
	if err != nil {
		if err == ErrSessionInUse {
			return 0, failure
		}
		return 0, err
	}
	if present {
		failure.Diagnostic = &diagnostic
	}
	return 0, failure
}

// Parse parses a byte buffer that may contain NUL bytes and returns the
// number of bytes parsed. A parse failure is a *ParseError, its Diagnostic
// set when the parse recorded one.
func (s *Session) Parse(input []byte) (int, error) {
	var data *C.char
	if len(input) > 0 {
		data = (*C.char)(unsafe.Pointer(&input[0]))
	}
	return s.parseOutcome(C.galley_parse(s.ptr, data, C.size_t(len(input))))
}

// ParseSentinel parses a string and returns the number of bytes parsed.
// The caller's bytes are passed by pointer and length; this does not
// allocate or copy in the binding. Interior NUL bytes are valid and are
// parsed as data, matching Parse.
func (s *Session) ParseSentinel(input string) (int, error) {
	var data *C.char
	if len(input) > 0 {
		data = (*C.char)(unsafe.Pointer(unsafe.StringData(input)))
	}
	return s.parseOutcome(C.galley_parse(s.ptr, data, C.size_t(len(input))))
}

// ParseFile parses the file at path and returns the number of bytes parsed.
func (s *Session) ParseFile(path string) (int, error) {
	cPath := C.CString(path)
	defer C.free(unsafe.Pointer(cPath))
	return s.parseOutcome(C.galley_parse_file(s.ptr, cPath))
}

// ParseInfo summarizes the most recent successful parse when AST
// construction is enabled.
type ParseInfo struct {
	Root              Node
	RootValid         bool
	EndLine, EndColumn uint32
}

// Info returns a summary of the published parse. The second result is false
// when AST construction is disabled; a non-nil error is the core's refusal of
// a read, such as ErrSessionInUse while a parse runs, or ErrStaleTree when
// nothing is published (before the first parse, or after one that published
// nothing).
func (s *Session) Info() (ParseInfo, bool, error) {
	if !HasAST() {
		return ParseInfo{}, false, nil
	}
	info := ParseInfo{}
	root, ok, err := s.RootNode()
	if err != nil {
		return ParseInfo{}, false, err
	}
	info.Root, info.RootValid = root, ok
	var line, column C.uint
	if status := C.galley_last_position(s.ptr, &line, &column); status < 0 {
		return ParseInfo{}, false, Error(int32(status))
	}
	info.EndLine, info.EndColumn = uint32(line), uint32(column)
	return info, true, nil
}

// publishedTree reads the published tree's root and generation from the
// core in one call: the only source of that generation and the one "is there
// a tree here" probe. The returned node carries that generation; with
// nothing published it is Node{} with an invalid address.
func (s *Session) publishedTree() (Node, error) {
	var root, generation C.ulonglong
	if status := C.galley_root_node(s.ptr, &root, &generation); status < 0 {
		return InvalidNode, Error(int32(status))
	}
	return Node{generation: uint64(generation), address: uint64(root)}, nil
}

// NodeCount returns the number of AST nodes in the published tree — 0 in a
// build without AST construction, where a live tree has no nodes — or
// ErrStaleTree when nothing is published.
func (s *Session) NodeCount() (uint64, error) {
	tree, err := s.publishedTree()
	if err != nil {
		return 0, err
	}
	return s.nodeCountIn(tree.generation)
}

// nodeCountIn counts the tree generation names; the core refuses a
// generation it does not hold, 0 included.
func (s *Session) nodeCountIn(generation uint64) (uint64, error) {
	count := C.galley_node_count(s.ptr, C.ulonglong(generation))
	if count < 0 {
		return 0, Error(int32(count))
	}
	return uint64(count), nil
}

// RootNode returns the root node of the published tree. It is the one "is
// there a tree here" probe: (root, true, nil) is the root, (_, false, nil)
// means nothing is published, and a non-nil error is the core's refusal,
// such as ErrSessionInUse while a parse runs.
func (s *Session) RootNode() (Node, bool, error) {
	tree, err := s.publishedTree()
	if err != nil {
		return Node{}, false, err
	}
	root, ok := cToNode(tree.generation, C.ulonglong(tree.address))
	return root, ok, nil
}

// ChildCount returns the number of direct children of a node.
func (s *Session) ChildCount(node Node) (uint32, error) { return s.door().childCount(node) }

// FirstChild returns the first child of a node.
func (s *Session) FirstChild(node Node) (Node, bool, error) { return s.door().firstChild(node) }

// LastChild returns the last child of a node.
func (s *Session) LastChild(node Node) (Node, bool, error) { return s.door().lastChild(node) }

// NextSibling returns the next sibling of a node.
func (s *Session) NextSibling(node Node) (Node, bool, error) { return s.door().nextSibling(node) }

// PriorSibling returns the previous sibling of a node.
func (s *Session) PriorSibling(node Node) (Node, bool, error) { return s.door().priorSibling(node) }

// Parent returns the parent of a node (false for the root).
func (s *Session) Parent(node Node) (Node, bool, error) { return s.door().parent(node) }

// doorHandle is what a node call is opened on: a session, or one parse's
// hook door. The galley_node_* and galley_hook_node_* families take the same
// arguments after the handle and answer the same way — the core checks the
// node's generation inside every call on either — so each capability is
// implemented once, here, and the Session and HookDoor methods only choose
// the handle. The family choice itself is made once, in the cgo preamble's
// galley_go_* dispatch functions. A refusal is a negative status and always
// an Error.
type doorHandle struct {
	c C.galley_go_door
	// life and epoch end a hook door with its parse: a door taken inside a
	// hook is usable until the session's epoch moves. nil for the session
	// door, which the core itself refuses when it is stale.
	life  *sessionLife
	epoch uint64
}

func (s *Session) door() doorHandle { return doorHandle{c: C.galley_go_door{session: s.ptr}} }

// open is the one place a call finds out whether its door is still usable:
// the C handle, or ErrStaleTree once the parse a hook door belongs to has
// ended, decided before the door's native pointer is touched.
func (d doorHandle) open() (C.galley_go_door, error) {
	if d.life != nil && atomic.LoadUint64(&d.life.epoch) != d.epoch {
		return C.galley_go_door{}, ErrStaleTree
	}
	return d.c, nil
}

func (d doorHandle) childCount(node Node) (uint32, error) {
	door, err := d.open()
	if err != nil {
		return 0, err
	}
	count := C.galley_go_node_child_count(door, C.ulonglong(node.generation), C.ulonglong(node.address))
	if count < 0 {
		return 0, Error(int32(count))
	}
	return uint32(count), nil
}

func (d doorHandle) firstChild(node Node) (Node, bool, error) {
	door, err := d.open()
	if err != nil {
		return Node{}, false, err
	}
	return oneLink(node, C.galley_go_node_first_child(door, C.ulonglong(node.generation), C.ulonglong(node.address)))
}

func (d doorHandle) lastChild(node Node) (Node, bool, error) {
	door, err := d.open()
	if err != nil {
		return Node{}, false, err
	}
	return oneLink(node, C.galley_go_node_last_child(door, C.ulonglong(node.generation), C.ulonglong(node.address)))
}

func (d doorHandle) nextSibling(node Node) (Node, bool, error) {
	door, err := d.open()
	if err != nil {
		return Node{}, false, err
	}
	return oneLink(node, C.galley_go_node_next_sibling(door, C.ulonglong(node.generation), C.ulonglong(node.address)))
}

func (d doorHandle) priorSibling(node Node) (Node, bool, error) {
	door, err := d.open()
	if err != nil {
		return Node{}, false, err
	}
	return oneLink(node, C.galley_go_node_prior_sibling(door, C.ulonglong(node.generation), C.ulonglong(node.address)))
}

func (d doorHandle) parent(node Node) (Node, bool, error) {
	door, err := d.open()
	if err != nil {
		return Node{}, false, err
	}
	return oneLink(node, C.galley_go_node_parent(door, C.ulonglong(node.generation), C.ulonglong(node.address)))
}

func (d doorHandle) symbolName(node Node) ([]byte, error) {
	door, err := d.open()
	if err != nil {
		return nil, err
	}
	var data *C.char
	var length C.size_t
	if status := C.galley_go_node_symbol_name(door, C.ulonglong(node.generation), C.ulonglong(node.address), &data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

func (d doorHandle) text(node Node) ([]byte, error) {
	door, err := d.open()
	if err != nil {
		return nil, err
	}
	var data *C.char
	var length C.size_t
	if status := C.galley_go_node_text(door, C.ulonglong(node.generation), C.ulonglong(node.address), &data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

func (d doorHandle) span(node Node) (start uint64, length uint64, err error) {
	door, err := d.open()
	if err != nil {
		return 0, 0, err
	}
	var cStart, cLength C.ulonglong
	if status := C.galley_go_node_span(door, C.ulonglong(node.generation), C.ulonglong(node.address), &cStart, &cLength); status < 0 {
		return 0, 0, Error(int32(status))
	}
	return uint64(cStart), uint64(cLength), nil
}

func (d doorHandle) lineColumn(node Node) (line uint32, column uint32, err error) {
	door, err := d.open()
	if err != nil {
		return 0, 0, err
	}
	var cLine, cColumn C.uint
	if status := C.galley_go_node_line_column(door, C.ulonglong(node.generation), C.ulonglong(node.address), &cLine, &cColumn); status < 0 {
		return 0, 0, Error(int32(status))
	}
	return uint32(cLine), uint32(cColumn), nil
}

// walkNext steps a walk cursor through this door.
func (d doorHandle) walkNext(cursor *C.GalleyWalkCursor) C.longlong {
	door, err := d.open()
	if err != nil {
		return C.longlong(ErrStaleTree)
	}
	return C.galley_go_walk_next(door, cursor)
}

// oneLink turns a link call's answer into the linked node: the answer is the
// address (GALLEY_INVALID_NODE when the link does not exist) or the core's
// refusal as a negative status, and the link carries the node's own
// generation.
func oneLink(node Node, answer C.longlong) (Node, bool, error) {
	if answer < 0 {
		return Node{}, false, Error(int32(answer))
	}
	found, ok := cToNode(node.generation, C.ulonglong(answer))
	return found, ok, nil
}

// Snapshot holds the published parse as flat slices: one
// entry per node address. Missing links read as InvalidNode.Index(), missing
// variables as -1, and spans index LastInput. Node turns an address of these
// columns into a handle of the parse they describe.
type Snapshot struct {
	// Generation is the parse the columns describe.
	Generation uint64
	Count      uint64
	Parent     []uint64
	FirstChild []uint64
	Next       []uint64
	ChildCount []uint32
	Variable   []int64
	SpanStart  []uint64
	SpanLen    []uint64
}

// Node returns the handle for address index of the snapshot's parse,
// converting a stored column address back to a node. The invalid-node
// constant answers the empty Node (generation 0 belongs to no parse, so
// every use of it is refused like any stale handle) and an address at or
// past Count panics with the host's index error at the call, like any Go
// index out of range; every other address is a node of the snapshot's
// parse. The handle goes stale with the snapshot: a later parse refuses it
// with ErrStaleTree.
func (snap Snapshot) Node(index uint64) Node {
	if index == invalidAddress {
		return Node{}
	}
	if index >= snap.Count {
		panic(fmt.Sprintf("node address %d out of range for a snapshot of %d nodes", index, snap.Count))
	}
	return Node{generation: snap.Generation, address: index}
}

// Snapshot returns the published tree in a single call. In a build without
// AST construction a live generation answers an empty snapshot (Count 0, nil
// columns) — a tree with no nodes; the calls that address a node refuse
// there. Walk Parent/FirstChild/Next directly instead of one call per node.
// Every leg carries one generation, so a parse that runs in between fails
// with ErrStaleTree instead of returning columns that mix two trees, and
// nothing published fails the same way rather than returning an empty
// snapshot.
func (s *Session) Snapshot() (Snapshot, error) {
	tree, err := s.publishedTree()
	if err != nil {
		return Snapshot{}, err
	}
	count, err := s.nodeCountIn(tree.generation)
	if err != nil {
		return Snapshot{}, err
	}
	snap := Snapshot{
		Generation: tree.generation,
		Count:      count,
		Parent:     make([]uint64, count),
		FirstChild: make([]uint64, count),
		Next:       make([]uint64, count),
		ChildCount: make([]uint32, count),
		Variable:   make([]int64, count),
		SpanStart:  make([]uint64, count),
		SpanLen:    make([]uint64, count),
	}
	// Always cross the gate, even at count 0: a stale or contended read
	// answers here (ErrStaleTree / ErrSessionInUse) rather than an
	// empty snapshot that hides the refusal. Columns stay nil at 0.
	var parent, firstChild, next *C.ulonglong
	var childCount *C.uint
	var variable *C.longlong
	var spanStart, spanLen *C.ulonglong
	if count > 0 {
		parent = (*C.ulonglong)(unsafe.Pointer(&snap.Parent[0]))
		firstChild = (*C.ulonglong)(unsafe.Pointer(&snap.FirstChild[0]))
		next = (*C.ulonglong)(unsafe.Pointer(&snap.Next[0]))
		childCount = (*C.uint)(unsafe.Pointer(&snap.ChildCount[0]))
		variable = (*C.longlong)(unsafe.Pointer(&snap.Variable[0]))
		spanStart = (*C.ulonglong)(unsafe.Pointer(&snap.SpanStart[0]))
		spanLen = (*C.ulonglong)(unsafe.Pointer(&snap.SpanLen[0]))
	}
	total := C.galley_tree_snapshot(
		s.ptr,
		C.ulonglong(tree.generation),
		parent,
		firstChild,
		next,
		childCount,
		variable,
		spanStart,
		spanLen,
		nil,
		nil,
		C.ulonglong(count),
	)
	if total < 0 {
		return Snapshot{}, Error(int32(total))
	}
	if uint64(total) != count {
		return Snapshot{}, ErrInternal
	}
	// The core's non-negative "no variable" becomes this API's -1.
	for i, variable := range snap.Variable {
		if variable == noVariable {
			snap.Variable[i] = -1
		}
	}
	return snap, nil
}

// LastInput returns the retained input of the published parse: the buffer
// snapshot spans index. It follows the published tree like every node read:
// ErrStaleTree whenever nothing is published (before the first parse
// included), ErrSessionInUse while a parse runs.
func (s *Session) LastInput() ([]byte, error) {
	var data *C.char
	var length C.size_t
	if status := C.galley_last_input(s.ptr, &data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

// Children returns the direct children of a node in document order.
func (s *Session) Children(node Node) ([]Node, error) {
	return Children(s, node)
}

// WalkStep is one pre-order step of a Walker.
type WalkStep struct {
	Node            Node
	Depth           uint32
	IsSemanticError bool
}

// Walker is a pre-order tree walker over the published parse. It owns
// no native resource: the cursor is the whole walker, so abandoning it is
// free and there is nothing to close. A walker left behind by a later
// parse answers ErrStaleTree at its next step instead of reading stale
// storage. Steps follow the live links, so edits between steps are
// visible; a step whose position is no longer inside the walk's root
// (removed, or moved elsewhere) reports ErrInvalidNode.
type Walker struct {
	// door is what each step crosses: the session, or the parse's hook door
	// for a walk created inside a hook dispatch.
	door   doorHandle
	cursor C.GalleyWalkCursor
}

// walkCursor builds a not-started cursor bound to the tree root came from:
// the cursor carries the root's own generation, which the core checks at
// every step, and skipSemanticErrors prunes subtrees rooted at
// semantic-error nodes.
func walkCursor(root Node, skipSemanticErrors bool) C.GalleyWalkCursor {
	cursor := C.GalleyWalkCursor{
		generation: C.ulonglong(root.generation),
		root:       C.ulonglong(root.address),
	}
	if skipSemanticErrors {
		cursor.options = C.uchar(C.GALLEY_WALK_SKIP_SEMANTIC_ERRORS)
	}
	return cursor
}

// Walk returns a pre-order Walker over the subtree rooted at node, with the
// root at depth 0. Pass true to prune subtrees rooted at semantic-error
// nodes. The walker owns no native resource, so nothing can fail at
// creation: a stale root fails at the first Next with ErrStaleTree, a build
// without AST construction with ErrInvalidNode.
func (s *Session) Walk(root Node, skipSemanticErrors bool) *Walker {
	return &Walker{door: s.door(), cursor: walkCursor(root, skipSemanticErrors)}
}

// Walk is the hook-door twin of Session.Walk: a pre-order walk over the
// in-flight parse's tree, bound to the root's generation and stepped through
// galley_hook_walk_next. Like Session.Walk, nothing fails at creation.
func (d HookDoor) Walk(root Node, skipSemanticErrors bool) *Walker {
	return &Walker{door: d.door(), cursor: walkCursor(root, skipSemanticErrors)}
}

// Next advances the walker. ok reports whether a step was yielded: false at
// the end of the walk and after a failed step, so a plain for/Next loop
// terminates either way. A finished walk is an answer, not an error: while
// its generation is live, every further step keeps answering (_, false, nil),
// and only a later parse makes it fail again with ErrStaleTree. A non-nil err
// reports the failure itself: ErrStaleTree for a walker whose tree a later
// parse replaced, ErrInvalidNode for a removed current node, ErrSessionInUse
// while a parse runs, or ErrNullArgument once the session is closed.
func (w *Walker) Next() (WalkStep, bool, error) {
	status := w.door.walkNext(&w.cursor)
	if status < 0 {
		return WalkStep{}, false, Error(int32(status))
	}
	if uint64(w.cursor.current) == invalidAddress {
		return WalkStep{}, false, nil
	}
	return WalkStep{
		Node:            Node{generation: uint64(w.cursor.generation), address: uint64(w.cursor.current)},
		Depth:           uint32(w.cursor.depth),
		IsSemanticError: w.cursor.flags&C.GALLEY_WALK_FLAG_SEMANTIC_ERROR != 0,
	}, true, nil
}

// SkipChildren prunes the children of the last yielded node; the next call
// continues with its next sibling. No effect without a last step. A
// host-side cursor state write; no native call.
func (w *Walker) SkipChildren() {
	if w.cursor.state == C.ushort(C.GALLEY_WALK_STATE_YIELDED) {
		w.cursor.state = C.ushort(C.GALLEY_WALK_STATE_YIELDED_SKIP_CHILDREN)
	}
}

// SymbolName returns the grammar symbol name of a node (empty for
// terminal-only nodes).
func (s *Session) SymbolName(node Node) ([]byte, error) { return s.door().symbolName(node) }

// SymbolNameAt returns the grammar symbol name at index into the symbol
// table (variables and terminals share one; SymbolIsTerminal tells them
// apart). The bytes are a Go copy of static grammar storage. An index at or
// past SymbolCount is ErrOutOfRange; a closed session is ErrNullArgument.
func (s *Session) SymbolNameAt(index uint64) ([]byte, error) {
	var data *C.char
	var length C.size_t
	if status := C.galley_symbol_name(s.ptr, C.ulonglong(index), &data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

// SymbolIsTerminal reports whether the grammar symbol at index is a
// terminal (or generative terminal); false means it is a variable. An index
// at or past SymbolCount is ErrOutOfRange.
func (s *Session) SymbolIsTerminal(index uint64) (bool, error) {
	var isTerminal C.int
	if status := C.galley_symbol_is_terminal(s.ptr, C.ulonglong(index), &isTerminal); status < 0 {
		return false, Error(int32(status))
	}
	return isTerminal != 0, nil
}

// VariableNameAt returns the grammar variable name at index. The bytes are
// a Go copy of static grammar storage. An index at or past VariableCount is
// ErrOutOfRange; a closed session is ErrNullArgument.
func (s *Session) VariableNameAt(index uint64) ([]byte, error) {
	var data *C.char
	var length C.size_t
	if status := C.galley_variable_name(s.ptr, C.ulonglong(index), &data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

// Text returns the source text matched by a node.
func (s *Session) Text(node Node) ([]byte, error) { return s.door().text(node) }

// Span returns the byte offset and length of a node's matched source span.
func (s *Session) Span(node Node) (start uint64, length uint64, err error) { return s.door().span(node) }

// LineColumn returns the 1-based line and column of a node's first byte.
func (s *Session) LineColumn(node Node) (line uint32, column uint32, err error) {
	return s.door().lineColumn(node)
}

// DiagnosticKind classifies the current diagnostic.
type DiagnosticKind int32

const (
	DiagnosticKindNone        DiagnosticKind = 0
	DiagnosticKindSyntax      DiagnosticKind = 1
	DiagnosticKindIndentation DiagnosticKind = 2
	DiagnosticKindSemantic    DiagnosticKind = 3
	DiagnosticKindHook        DiagnosticKind = 4
)

// RecoveryTarget names what a recovered syntax diagnostic's recovery
// damaged. It is RecoveryTargetNone when the diagnostic carries no recovery
// information, whatever the reason.
type RecoveryTarget int32

const (
	RecoveryTargetNone        RecoveryTarget = 0
	RecoveryTargetLHSVariable RecoveryTarget = 1
	RecoveryTargetProduction  RecoveryTarget = 2
	RecoveryTargetOccurrence  RecoveryTarget = 3
)

// SemanticInfo carries the variable and message of a semantic diagnostic.
type SemanticInfo struct {
	Variable, Message string
}

// Diagnostic describes the failure of the most recent parse, mirroring the
// structured diagnostic of the C API.
type Diagnostic struct {
	Kind DiagnosticKind
	// SyntaxErrorCount and SemanticErrorCount are the totals of the parse
	// the diagnostic belongs to: they describe the parse, not one
	// diagnostic, so every diagnostic of one parse carries the same
	// counts. A hook-door snapshot reports the running parse's totals
	// through the hook door's twins; a session snapshot reads the
	// session's own counters.
	SyntaxErrorCount   uint64
	SemanticErrorCount uint64
	// RecoveryTarget names the recovery target of a recovered syntax
	// diagnostic (RecoveryTargetNone when there is no recovery
	// information).
	RecoveryTarget RecoveryTarget
	// Offset is the byte offset of the failure in the input.
	Offset uint64
	// Line and Column are 1-based; both are 0 when the diagnostic has none.
	Line, Column    uint32
	Message         string
	UnexpectedToken []byte
	ExpectedTokens  [][]byte
	// Context lists the innermost-first "while parsing" variable chain
	// (syntax and semantic diagnostics).
	Context []string
	// Semantic is set for semantic diagnostics only.
	Semantic *SemanticInfo
}

// diagnosticReads is one diagnostic's reads, bound to the door that answers
// them: the session's current (most recent) diagnostic, the session's record
// at an index, or the parse-time hook door. Each field is one C call; a
// negative status is a refusal, never folded into an answer.
type diagnosticReads struct {
	kind          func() C.longlong
	syntaxCount   func() C.longlong
	semanticCount func() C.longlong
	position      func(*C.ulonglong, *C.uint, *C.uint) C.longlong
	message       func(**C.char) C.longlong
	recovery      func() C.longlong
	token         func(**C.char, *C.size_t) C.longlong
	expected      func() C.longlong
	expectedAt    func(C.ulonglong, **C.char, *C.size_t) C.longlong
	context       func() C.longlong
	contextAt     func(C.ulonglong, **C.char, *C.size_t) C.longlong
	semantic      func(**C.char, *C.size_t, **C.char, *C.size_t) C.longlong
}

// currentDiagnosticReads binds the session's current diagnostic, the most
// recent one the most recent parse recorded.
func currentDiagnosticReads(session *Session) diagnosticReads {
	return diagnosticReads{
		kind: func() C.longlong { return C.galley_diagnostic_kind(session.ptr) },
		syntaxCount: func() C.longlong { return C.galley_syntax_error_count(session.ptr) },
		semanticCount: func() C.longlong { return C.galley_semantic_error_count(session.ptr) },
		position: func(offset *C.ulonglong, line, column *C.uint) C.longlong {
			return C.galley_diagnostic_position(session.ptr, offset, line, column)
		},
		message:  func(out **C.char) C.longlong { return C.galley_diagnostic_message(session.ptr, out) },
		recovery: func() C.longlong { return C.galley_diagnostic_recovery_kind(session.ptr) },
		token: func(data **C.char, length *C.size_t) C.longlong {
			return C.galley_diagnostic_unexpected_token(session.ptr, data, length)
		},
		expected: func() C.longlong { return C.galley_diagnostic_expected_count(session.ptr) },
		expectedAt: func(index C.ulonglong, data **C.char, length *C.size_t) C.longlong {
			return C.galley_diagnostic_expected_at(session.ptr, index, data, length)
		},
		context: func() C.longlong { return C.galley_diagnostic_context_count(session.ptr) },
		contextAt: func(index C.ulonglong, data **C.char, length *C.size_t) C.longlong {
			return C.galley_diagnostic_context_at(session.ptr, index, data, length)
		},
		semantic: func(variable **C.char, variableLength *C.size_t, message **C.char, messageLength *C.size_t) C.longlong {
			return C.galley_diagnostic_semantic(session.ptr, variable, variableLength, message, messageLength)
		},
	}
}

// recordedDiagnosticReads binds the session's record at index (0-based, in
// recording order) of the most recent parse.
func recordedDiagnosticReads(session *Session, index C.ulonglong) diagnosticReads {
	return diagnosticReads{
		kind: func() C.longlong { return C.galley_recorded_diagnostic_kind(session.ptr, index) },
		syntaxCount: func() C.longlong { return C.galley_syntax_error_count(session.ptr) },
		semanticCount: func() C.longlong { return C.galley_semantic_error_count(session.ptr) },
		position: func(offset *C.ulonglong, line, column *C.uint) C.longlong {
			return C.galley_recorded_diagnostic_position(session.ptr, index, offset, line, column)
		},
		message: func(out **C.char) C.longlong {
			return C.galley_recorded_diagnostic_message(session.ptr, index, out)
		},
		recovery: func() C.longlong { return C.galley_recorded_diagnostic_recovery_kind(session.ptr, index) },
		token: func(data **C.char, length *C.size_t) C.longlong {
			return C.galley_recorded_unexpected_token(session.ptr, index, data, length)
		},
		expected: func() C.longlong { return C.galley_recorded_expected_count(session.ptr, index) },
		expectedAt: func(tokenIndex C.ulonglong, data **C.char, length *C.size_t) C.longlong {
			return C.galley_recorded_expected_token(session.ptr, index, tokenIndex, data, length)
		},
		context: func() C.longlong { return C.galley_recorded_context_count(session.ptr, index) },
		contextAt: func(contextIndex C.ulonglong, data **C.char, length *C.size_t) C.longlong {
			return C.galley_recorded_context_name(session.ptr, index, contextIndex, data, length)
		},
		semantic: func(variable **C.char, variableLength *C.size_t, message **C.char, messageLength *C.size_t) C.longlong {
			return C.galley_recorded_semantic(session.ptr, index, variable, variableLength, message, messageLength)
		},
	}
}

// hookDiagnosticReads binds the in-flight parse's current diagnostic through
// its hook door. The door is already open (the Go epoch was crossed); the
// core owns whether it is still live.
func hookDiagnosticReads(door C.galley_go_door) diagnosticReads {
	return diagnosticReads{
		kind: func() C.longlong { return C.galley_hook_diagnostic_kind(door.hook) },
		syntaxCount: func() C.longlong { return C.galley_hook_syntax_error_count(door.hook) },
		semanticCount: func() C.longlong { return C.galley_hook_semantic_error_count(door.hook) },
		position: func(offset *C.ulonglong, line, column *C.uint) C.longlong {
			return C.galley_hook_diagnostic_position(door.hook, offset, line, column)
		},
		message:  func(out **C.char) C.longlong { return C.galley_hook_diagnostic_message(door.hook, out) },
		recovery: func() C.longlong { return C.galley_hook_diagnostic_recovery_kind(door.hook) },
		token: func(data **C.char, length *C.size_t) C.longlong {
			return C.galley_hook_diagnostic_unexpected_token(door.hook, data, length)
		},
		expected: func() C.longlong { return C.galley_hook_diagnostic_expected_count(door.hook) },
		expectedAt: func(index C.ulonglong, data **C.char, length *C.size_t) C.longlong {
			return C.galley_hook_diagnostic_expected_at(door.hook, index, data, length)
		},
		context: func() C.longlong { return C.galley_hook_diagnostic_context_count(door.hook) },
		contextAt: func(index C.ulonglong, data **C.char, length *C.size_t) C.longlong {
			return C.galley_hook_diagnostic_context_at(door.hook, index, data, length)
		},
		semantic: func(variable **C.char, variableLength *C.size_t, message **C.char, messageLength *C.size_t) C.longlong {
			return C.galley_hook_diagnostic_semantic(door.hook, variable, variableLength, message, messageLength)
		},
	}
}

// errorCounts reads the parse's syntax and semantic error totals. They
// describe the parse, not one diagnostic, so every diagnostic of the parse
// carries them, and the same door that answers the diagnostic answers the
// totals (the hook door's twins while a parse runs).
func (reads diagnosticReads) errorCounts() (syntax uint64, semantic uint64, err error) {
	status := reads.syntaxCount()
	if status < 0 {
		return 0, 0, Error(int32(status))
	}
	syntax = uint64(status)
	if status = reads.semanticCount(); status < 0 {
		return 0, 0, Error(int32(status))
	}
	return syntax, uint64(status), nil
}

func (reads diagnosticReads) diagnosticPosition() (offset uint64, line uint32, column uint32, err error) {
	var cOffset C.ulonglong
	var cLine, cColumn C.uint
	if status := reads.position(&cOffset, &cLine, &cColumn); status < 0 {
		return 0, 0, 0, Error(int32(status))
	}
	return uint64(cOffset), uint32(cLine), uint32(cColumn), nil
}

func (reads diagnosticReads) recoveryTarget() (RecoveryTarget, error) {
	status := reads.recovery()
	if status < 0 {
		return RecoveryTargetNone, Error(int32(status))
	}
	return RecoveryTarget(status), nil
}

func (reads diagnosticReads) diagnosticMessage() (string, error) {
	var message *C.char
	if status := reads.message(&message); status < 0 {
		return "", Error(int32(status))
	}
	return C.GoString(message), nil
}

func (reads diagnosticReads) unexpectedToken() ([]byte, error) {
	var data *C.char
	var length C.size_t
	if status := reads.token(&data, &length); status < 0 {
		return nil, Error(int32(status))
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

func (reads diagnosticReads) expectedTokens() ([][]byte, error) {
	count := reads.expected()
	if count < 0 {
		return nil, Error(int32(count))
	}
	var tokens [][]byte
	for index := C.ulonglong(0); index < C.ulonglong(count); index++ {
		var data *C.char
		var length C.size_t
		if status := reads.expectedAt(index, &data, &length); status < 0 {
			return nil, Error(int32(status))
		}
		tokens = append(tokens, C.GoBytes(unsafe.Pointer(data), C.int(length)))
	}
	return tokens, nil
}

func (reads diagnosticReads) contextNames() ([]string, error) {
	count := reads.context()
	if count < 0 {
		return nil, Error(int32(count))
	}
	var names []string
	for index := C.ulonglong(0); index < C.ulonglong(count); index++ {
		var data *C.char
		var length C.size_t
		if status := reads.contextAt(index, &data, &length); status < 0 {
			return nil, Error(int32(status))
		}
		names = append(names, C.GoStringN(data, C.int(length)))
	}
	return names, nil
}

func (reads diagnosticReads) semanticFields() (*SemanticInfo, error) {
	var variableData, messageData *C.char
	var variableLength, messageLength C.size_t
	if status := reads.semantic(&variableData, &variableLength, &messageData, &messageLength); status < 0 {
		return nil, Error(int32(status))
	}
	return &SemanticInfo{
		Variable: C.GoStringN(variableData, C.int(variableLength)),
		Message:  C.GoStringN(messageData, C.int(messageLength)),
	}, nil
}

// buildDiagnostic snapshots the diagnostic a set of reads answers, the one
// builder behind every diagnostic surface. present is false only when the
// door has no diagnostic at all (kind none); every refused read is returned
// as the error, never folded into an absence or a zero field. Fields are
// read by the record's kind — syntax records carry the unexpected and
// expected tokens, syntax and semantic records a context chain, semantic
// records their variable and message — so a read that cannot apply to the
// record is never made.
func buildDiagnostic(reads diagnosticReads) (Diagnostic, bool, error) {
	kindStatus := reads.kind()
	if kindStatus < 0 {
		return Diagnostic{}, false, Error(int32(kindStatus))
	}
	kind := DiagnosticKind(kindStatus)
	if kind == DiagnosticKindNone {
		return Diagnostic{}, false, nil
	}
	diagnostic := Diagnostic{Kind: kind}
	offset, line, column, err := reads.diagnosticPosition()
	if err != nil {
		return Diagnostic{}, false, err
	}
	diagnostic.Offset, diagnostic.Line, diagnostic.Column = offset, line, column
	if diagnostic.SyntaxErrorCount, diagnostic.SemanticErrorCount, err = reads.errorCounts(); err != nil {
		return Diagnostic{}, false, err
	}
	if diagnostic.RecoveryTarget, err = reads.recoveryTarget(); err != nil {
		return Diagnostic{}, false, err
	}
	if diagnostic.Message, err = reads.diagnosticMessage(); err != nil {
		return Diagnostic{}, false, err
	}
	if kind == DiagnosticKindSyntax {
		if diagnostic.UnexpectedToken, err = reads.unexpectedToken(); err != nil {
			return Diagnostic{}, false, err
		}
		if diagnostic.ExpectedTokens, err = reads.expectedTokens(); err != nil {
			return Diagnostic{}, false, err
		}
	}
	if kind == DiagnosticKindSyntax || kind == DiagnosticKindSemantic {
		if diagnostic.Context, err = reads.contextNames(); err != nil {
			return Diagnostic{}, false, err
		}
	}
	if kind == DiagnosticKindSemantic {
		if diagnostic.Semantic, err = reads.semanticFields(); err != nil {
			return Diagnostic{}, false, err
		}
	}
	return diagnostic, true, nil
}

// HasDiagnostic reports whether the previous parse produced a diagnostic. A
// parse in flight is refused with ErrSessionInUse, never answered false;
// hook code reads the running parse through HookDoor.HasDiagnostic.
func (s *Session) HasDiagnostic() (bool, error) {
	var has C.int
	if status := C.galley_has_diagnostic(s.ptr, &has); status < 0 {
		return false, Error(int32(status))
	}
	return has != 0, nil
}

// Diagnostic inspects the failure of the most recent parse (its most
// recently recorded diagnostic). The second result is false when the parse
// succeeded (or nothing was parsed yet). Its message is the text rendered
// for that diagnostic, grammar hooks and message overrides included. A
// refused read is the core's error, never a false.
func (s *Session) Diagnostic() (Diagnostic, bool, error) {
	return buildDiagnostic(currentDiagnosticReads(s))
}

// Diagnostics returns every diagnostic recorded during the most recent
// parse, in recording order. Nil when the parse succeeded. A refused read is
// the core's error, never an empty or short list.
func (s *Session) Diagnostics() ([]Diagnostic, error) {
	count := C.galley_recorded_diagnostic_count(s.ptr)
	if count < 0 {
		return nil, Error(int32(count))
	}
	if count == 0 {
		return nil, nil
	}
	diagnostics := make([]Diagnostic, 0, int(count))
	for index := C.ulonglong(0); index < C.ulonglong(count); index++ {
		diagnostic, present, err := buildDiagnostic(recordedDiagnosticReads(s, index))
		if err != nil {
			return nil, err
		}
		if !present {
			// The core counted a record at this index and then reported no
			// diagnostic for it; a skip here would answer a short list.
			return nil, ErrNoDiagnostic
		}
		diagnostics = append(diagnostics, diagnostic)
	}
	return diagnostics, nil
}

// SyntaxErrorCount returns how many syntax errors the most recent
// recovery-enabled parse recorded; a fail-fast parse reports at most one.
// Zero before any parse and after a syntax-clean one. A refused read is the
