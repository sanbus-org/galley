// ReserveNodes preallocates node storage for at least capacity nodes.
func (s *Session) ReserveNodes(capacity uint64) error {
	return s.treeStatus(C.galley_reserve_nodes(s.ptr, C.ulonglong(capacity)))
}

// NodeCapacity returns the current node storage capacity in nodes.
func (s *Session) NodeCapacity() uint64 {
	return uint64(C.galley_node_capacity(s.ptr))
}

// NodeDoor is one of the two doors over node storage: a post-parse
// *Session or the parse's HookDoor. Shared helpers take this interface —
// hooks pass the door, session code passes the session — so each read has
// one implementation.
type NodeDoor interface {
	ChildCount(node Node) (uint32, error)
	Children(node Node) ([]Node, error)
	FirstChild(node Node) (Node, bool, error)
	LastChild(node Node) (Node, bool, error)
	NextSibling(node Node) (Node, bool, error)
	PriorSibling(node Node) (Node, bool, error)
	Parent(node Node) (Node, bool, error)
	SymbolName(node Node) ([]byte, error)
	Text(node Node) ([]byte, error)
	Span(node Node) (start uint64, length uint64, err error)
	LineColumn(node Node) (line uint32, column uint32, err error)
}

// Children returns the direct children of a node in document order,
// through either door: the iteration runs over the door's link
// primitives, so each door keeps its own gate on every step. A refusal
// ends the iteration and is reported, never answered with a short list.
func Children(door NodeDoor, node Node) ([]Node, error) {
	children := []Node{}
	child, ok, err := door.FirstChild(node)
	if err != nil {
		return nil, err
	}
	for ok {
		children = append(children, child)
		child, ok, err = door.NextSibling(child)
		if err != nil {
			return nil, err
		}
	}
	return children, nil
}

// ProcedureArgs is the per-hook argument passed to a Go procedure hook:
// the current node, the scanner position, drop and replace, and semantic
// errors. It is valid only while the hook runs. Tree reads do not go
// through it: take the parse's door with Door.
type ProcedureArgs struct {
	ptr unsafe.Pointer
}

// Args wraps the opaque pointer the parser passes to a hook.
func Args(ptr unsafe.Pointer) ProcedureArgs {
	return ProcedureArgs{ptr: ptr}
}

func (a ProcedureArgs) cptr() unsafe.Pointer { return a.ptr }

// HookDoor is the parse-time door over one parse's node storage: node reads
// go through the galley_hook_* twins on it. Every hook of one parse gets the
// same door, and it is valid until that parse ends — a value copied out of
// a hook stays usable while that parse runs and must not be retained past
// it, because the next parse resets the storage it reads. Keep Node
// handles for references that outlive the parse.
type HookDoor struct {
	ptr unsafe.Pointer
}

// Door returns the door of the parse this hook belongs to.
func (a ProcedureArgs) Door() HookDoor {
	return HookDoor{ptr: unsafe.Pointer(C.galley_procedure_door(a.cptr()))}
}

func (d HookDoor) cptr() *C.GalleyHookDoor { return (*C.GalleyHookDoor)(d.ptr) }

// CurrentNode is the node being reduced.
func (a ProcedureArgs) CurrentNode() (Node, bool) {
	// The parse's generation, which the core reports for this door; 0 (never
	// live) if it cannot, so a node made without it is stale.
	var generation C.ulonglong
	if C.galley_hook_generation(C.galley_procedure_door(a.cptr()), &generation) < 0 {
		generation = 0
	}
	return cToNode(uint64(generation), C.galley_procedure_current_node(a.cptr()))
}

// ChildCount reports node's child count through the parse-time door.
func (d HookDoor) ChildCount(node Node) (uint32, error) {
	return uint32(C.galley_hook_node_child_count(d.cptr(), C.ulonglong(node.address))), nil
}

// Children returns node's children, in birth order, through the parse-time door.
func (d HookDoor) Children(node Node) ([]Node, error) {
	return Children(d, node)
}

// FirstChild returns node's first child through the parse-time door.
func (d HookDoor) FirstChild(node Node) (Node, bool, error) {
	found, ok := cToNode(node.generation, C.galley_hook_node_first_child(d.cptr(), C.ulonglong(node.address)))
	return found, ok, nil
}

// LastChild returns node's last child through the parse-time door.
func (d HookDoor) LastChild(node Node) (Node, bool, error) {
	found, ok := cToNode(node.generation, C.galley_hook_node_last_child(d.cptr(), C.ulonglong(node.address)))
	return found, ok, nil
}

// NextSibling returns node's next sibling through the parse-time door.
func (d HookDoor) NextSibling(node Node) (Node, bool, error) {
	found, ok := cToNode(node.generation, C.galley_hook_node_next_sibling(d.cptr(), C.ulonglong(node.address)))
	return found, ok, nil
}

// PriorSibling returns node's prior sibling through the parse-time door.
func (d HookDoor) PriorSibling(node Node) (Node, bool, error) {
	found, ok := cToNode(node.generation, C.galley_hook_node_prior_sibling(d.cptr(), C.ulonglong(node.address)))
	return found, ok, nil
}

// Parent returns node's parent through the parse-time door.
func (d HookDoor) Parent(node Node) (Node, bool, error) {
	found, ok := cToNode(node.generation, C.galley_hook_node_parent(d.cptr(), C.ulonglong(node.address)))
	return found, ok, nil
}

// SymbolName returns the grammar symbol name of a node through the
// parse-time door (empty for terminal-only nodes).
func (d HookDoor) SymbolName(node Node) ([]byte, error) {
	var data *C.char
	var length C.size_t
	if C.galley_hook_node_symbol_name(d.cptr(), C.ulonglong(node.address), &data, &length) != 0 {
		return nil, ErrInvalidNode
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

// Text returns the source text matched by a node through the parse-time door.
func (d HookDoor) Text(node Node) ([]byte, error) {
	var data *C.char
	var length C.size_t
	if C.galley_hook_node_text(d.cptr(), C.ulonglong(node.address), &data, &length) != 0 {
		return nil, ErrInvalidNode
	}
	return C.GoBytes(unsafe.Pointer(data), C.int(length)), nil
}

// Span returns the byte offset and length of a node's matched source span
// through the parse-time door.
func (d HookDoor) Span(node Node) (start uint64, length uint64, err error) {
	var cStart, cLength C.ulonglong
	if C.galley_hook_node_span(d.cptr(), C.ulonglong(node.address), &cStart, &cLength) != 0 {
		return 0, 0, ErrInvalidNode
	}
	return uint64(cStart), uint64(cLength), nil
}

// LineColumn returns the 1-based line and column of a node's first byte
// through the parse-time door.
func (d HookDoor) LineColumn(node Node) (line uint32, column uint32, err error) {
	var cLine, cColumn C.uint
	if C.galley_hook_node_line_column(d.cptr(), C.ulonglong(node.address), &cLine, &cColumn) != 0 {
		return 0, 0, ErrInvalidNode
	}
	return uint32(cLine), uint32(cColumn), nil
}

func procedureStatus(status C.longlong) error {
	if status >= 0 {
		return nil
	}
	return Error(int32(status))
}

// DropSelf drops the current node from the parse.
func (a ProcedureArgs) DropSelf() error {
	return procedureStatus(C.galley_procedure_drop_self(a.cptr()))
}

// DropChildren drops children of the current node.
func (a ProcedureArgs) DropChildren() error {
	return procedureStatus(C.galley_procedure_drop_children(a.cptr()))
}

// DropIfEmpty drops the current node when it has no children.
func (a ProcedureArgs) DropIfEmpty() error {
	return procedureStatus(C.galley_procedure_drop_if_empty(a.cptr()))
}

// ReplaceWithChildren replaces the current node with its children.
func (a ProcedureArgs) ReplaceWithChildren() error {
	return procedureStatus(C.galley_procedure_replace_with_children(a.cptr()))
}

// ReportSemanticError records a semantic error on the current node and
// returns the running total. Parsing continues; a syntax-clean parse with
// any semantic error fails with ErrSemantic.
func (a ProcedureArgs) ReportSemanticError(message string) (uint64, error) {
	cMessage := C.CString(message)
	defer C.free(unsafe.Pointer(cMessage))
	status := C.galley_procedure_report_semantic_error(a.cptr(), cMessage, C.size_t(len(message)))
	if status < 0 {
		return 0, Error(int32(status))
	}
	return uint64(status), nil
}

// Line is the scanner line during this reduction.
func (a ProcedureArgs) Line() uint32 {
	return uint32(C.galley_procedure_context_line(a.cptr()))
}

// Column is the scanner column during this reduction.
func (a ProcedureArgs) Column() uint32 {
	return uint32(C.galley_procedure_context_column(a.cptr()))
}
