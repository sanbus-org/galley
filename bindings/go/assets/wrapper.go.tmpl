}

// NodeCapacity returns the current node storage capacity in nodes, or
// ErrSessionInUse while a parse runs.
func (s *Session) NodeCapacity() (uint64, error) {
	capacity := C.galley_node_capacity(s.ptr)
	if capacity < 0 {
		return 0, Error(int32(capacity))
	}
	return uint64(capacity), nil
}

// NodeDoor is one of the two doors over node storage: a post-parse
// *Session or the parse's HookDoor. Shared helpers take this interface —
// hooks pass the door, session code passes the session — so each read has
// one implementation.
type NodeDoor interface {
	ChildCount(node Node) (uint32, error)
	Children(node Node) ([]Node, error)
	FirstChild(node Node) (Node, bool, error)
	LastChild(node Node) (Node, bool, error)
	NextSibling(node Node) (Node, bool, error)
	PriorSibling(node Node) (Node, bool, error)
	Parent(node Node) (Node, bool, error)
	SymbolName(node Node) ([]byte, error)
	Text(node Node) ([]byte, error)
	Span(node Node) (start uint64, length uint64, err error)
	LineColumn(node Node) (line uint32, column uint32, err error)
}

// Children returns the direct children of a node in document order,
// through either door: the iteration runs over the door's link
// primitives, so each door keeps its own gate on every step. A refusal
// ends the iteration and is reported, never answered with a short list.
func Children(door NodeDoor, node Node) ([]Node, error) {
	children := []Node{}
	child, ok, err := door.FirstChild(node)
	if err != nil {
		return nil, err
	}
	for ok {
		children = append(children, child)
		child, ok, err = door.NextSibling(child)
		if err != nil {
			return nil, err
		}
	}
	return children, nil
}

// ProcedureArgs is the per-hook argument passed to a Go procedure hook:
// the current node, the scanner position, drop and replace, and semantic
// errors. It is valid only while the hook runs: it names its hook by the
// session and the ticket the core issued for the call, and the core refuses
// every call made with the ticket of a hook that has returned (ErrStaleHook).
// Tree reads do not go through it: take the parse's door with Door.
type ProcedureArgs struct {
	session unsafe.Pointer
	hook    uint64
}

// Args wraps the session and the ticket the parser passes to a hook.
func Args(session unsafe.Pointer, hook uint64) ProcedureArgs {
	return ProcedureArgs{session: session, hook: hook}
}

// open is the one gate to the session the arguments name: a session that was
// closed is refused (ErrNullArgument, like every use after Close) before its
// freed memory is read. Whether the hook is still running is the core's to
// say, by the ticket.
func (a ProcedureArgs) open() (*C.GalleySession, error) {
	if _, ok := sessions.Load(uintptr(a.session)); !ok {
		return nil, ErrNullArgument
	}
	return (*C.GalleySession)(a.session), nil
}

func (a ProcedureArgs) cticket() C.ulonglong { return C.ulonglong(a.hook) }

// HookDoor is the parse-time door over one parse's node storage: node reads
// go through the galley_hook_* twins on it, which check the node's generation
// like the session door does (ErrStaleTree for a node of another parse). Every
// hook of one parse gets the same door, and it is usable for as long as that
// parse runs: a copy kept from one hook still works in a later hook of the
// same parse. When Parse (or ParseSentinel, ParseFile) returns, the door and
// every Walker made from it answer ErrStaleTree, without reading the native
// door, which died with the parse. Keep Node handles for references that
// outlive the parse; they are refused with ErrStaleTree once the next parse
// replaces the tree.
type HookDoor struct {
	ptr unsafe.Pointer
	// life and epoch tie the door to its parse: see sessionLife.
	life  *sessionLife
	epoch uint64
}

// Door returns the door of the parse this hook belongs to, or the core's
// refusal: ErrStaleHook once the hook has returned, ErrNullArgument after the
// session is closed.
func (a ProcedureArgs) Door() (HookDoor, error) {
	session, err := a.open()
	if err != nil {
		return HookDoor{}, err
	}
	var native *C.GalleyHookDoor
	if status := C.galley_procedure_door(session, a.cticket(), &native); status < 0 {
		return HookDoor{}, Error(int32(status))
	}
	door := HookDoor{ptr: unsafe.Pointer(native)}
	// The hook's own session names the life the door ends with.
	life, _ := sessions.Load(uintptr(a.session))
	door.life = life.(*sessionLife)
	door.epoch = atomic.LoadUint64(&door.life.epoch)
	return door, nil
}

func (d HookDoor) cptr() *C.GalleyHookDoor { return (*C.GalleyHookDoor)(d.ptr) }

// CurrentNode is the node being reduced, false when there is none. The core's
// refusal to report the parse's generation is an error, never a node stamped
// with generation 0.
func (a ProcedureArgs) CurrentNode() (Node, bool, error) {
	session, err := a.open()
	if err != nil {
		return Node{}, false, err
	}
	var native *C.GalleyHookDoor
	if status := C.galley_procedure_door(session, a.cticket(), &native); status < 0 {
		return Node{}, false, Error(int32(status))
	}
	var generation C.ulonglong
	if status := C.galley_hook_generation(native, &generation); status < 0 {
		return Node{}, false, Error(int32(status))
	}
	current := C.galley_procedure_current_node(session, a.cticket())
	if current < 0 {
		return Node{}, false, Error(int32(current))
	}
	node, ok := cToNode(uint64(generation), C.ulonglong(current))
	return node, ok, nil
}

func (d HookDoor) door() doorHandle {
	return doorHandle{c: C.galley_go_door{hook: d.cptr()}, life: d.life, epoch: d.epoch}
}

// ChildCount reports node's child count through the parse-time door.
func (d HookDoor) ChildCount(node Node) (uint32, error) { return d.door().childCount(node) }

// Children returns node's children, in birth order, through the parse-time door.
func (d HookDoor) Children(node Node) ([]Node, error) {
	return Children(d, node)
}

// FirstChild returns node's first child through the parse-time door.
func (d HookDoor) FirstChild(node Node) (Node, bool, error) { return d.door().firstChild(node) }

// LastChild returns node's last child through the parse-time door.
