# Galley's own `.grm` syntax, LL engine: rule definitions, `|` alternatives,
# symbols, quoted terminals, and `@` annotations. The bootstrap parser is
# generated from this file, so it also parses itself.

Start
| Rules

Rules
| Comment OptionalNewLineMany Rule RulesTail

RulesTail
| NewLine RulesTail
| Rule RulesTail
|

Rule@!^"\n\n"
| VariableSymbol AnnotationTail NewLine RightHandSides

RightHandSides
| RightHandSideLine RightHandSides
| RightHandSideLine

RightHandSideLine@!"\n"^
| "|" AnnotationTail RightHandSide NewLine

RightHandSide
| space Symbol@!^"\n" AnnotationTail RightHandSide
|

Symbol
| VariableSymbol
| TerminalSymbol
| GenerativeTerminalSymbol

VariableSymbol
| UppercaseId
| "_" UppercaseId

TerminalSymbol
| RawString
| "\u{22}" SimpleStringContent "\u{22}"

RawString
| "\u{5c}\u{22}" RawIndicator@>> "\u{22}"

RawIndicator
| character^"\u{22}"^"\n"^"\\"

GenerativeTerminalSymbol
| LowercaseId GenerativeTerminalExceptions

GenerativeTerminalExceptions
| "^" TerminalSymbol GenerativeTerminalExceptions
|

AnnotationTail
| "@" Annotation AnnotationTail
|

Annotation
| Procedure
| "!" RecoveryPoint
| ">" VerbatimMarker

Procedure
| CamelCaseId

RecoveryPoint
| TerminalAndCursor

VerbatimMarker
| ">"
| TerminalAndCursor

TerminalAndCursor
| "^" TerminalSymbol
| TerminalSymbol "^"

SimpleStringContent
| character^"\u{22}" SimpleStringContent
| _Utf8Scalar SimpleStringContent
|

_Utf8Scalar
| _Utf8TwoByte
| _Utf8ThreeByte
| _Utf8FourByte

_Utf8TwoByte
| utf8_lead_two utf8_continuation

_Utf8ThreeByte
| "\xe0" utf8_continuation_a0_bf utf8_continuation
| utf8_lead_three_general utf8_continuation utf8_continuation
| "\xed" utf8_continuation_80_9f utf8_continuation

_Utf8FourByte
| "\xf0" utf8_continuation_90_bf utf8_continuation utf8_continuation
| utf8_lead_four_general utf8_continuation utf8_continuation utf8_continuation
| "\xf4" utf8_continuation_80_8f utf8_continuation utf8_continuation

ControlCharacter
| "\x01"
| "\x02"

AnyContent
| character^"\n" AnyContent
| ControlCharacter AnyContent
| character^"\n"
| ControlCharacter

IdTail
| letter IdTail
| digit IdTail
| "_" IdTail
|

LowercaseId
| lowercase_letter IdTail

UppercaseId
| uppercase_letter IdTail

CamelCaseId
| lowercase_letter CamelCaseIdTail

CamelCaseIdTail
| letter CamelCaseIdTail
| digit CamelCaseIdTail
|

OptionalNewLineMany
| NewLine OptionalNewLineMany
|

NewLine
| new_line Comment

BlockStart
| block_start Comment

BlockEnd
| block_end Comment

CommentLine
| "#"@>^"\n" new_line

Comment
| CommentLine Comment
|
